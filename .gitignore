# Root-level ignores shared across backend (Rails) and frontend (Node/Vite).
# Each app also has its own more specific .gitignore (backend/.gitignore,
# frontend/.gitignore) generated by their respective scaffolding tools.

# OS / editor cruft
.DS_Store
*.swp
.vscode/*
!.vscode/extensions.json
.idea

# Node
node_modules/
npm-debug.log*

# Ruby / Rails
/backend/log/*
!/backend/log/.keep
/backend/tmp/*
!/backend/tmp/.keep
/backend/storage/*
!/backend/storage/.keep
/backend/config/*.key
/backend/.bundle

# Build output
/frontend/dist/
/frontend/storybook-static/
/frontend/playwright-report/
/frontend/test-results/
/frontend/coverage/
/backend/coverage/

# Env
.env
.env.local
.env.*.local

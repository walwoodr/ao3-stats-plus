# Copy to .env.local for local overrides (gitignored).

# URL of the Rails GraphQL endpoint. Defaults to http://localhost:3000/graphql
# in code if unset (see src/lib/graphqlClient.ts), so this only needs setting
# here for a non-default backend port, or when tunneling for bookmarklet
# testing against real AO3 (see README.md, "Testing the bookmarklet against
# real AO3" - `npm run tunnel:backend` sets this automatically for that case).
VITE_GRAPHQL_URL=http://localhost:3000/graphql

# Origin (scheme + host [+ port], no path) of the Rails API that the
# bookmarklet (bookmarklet.js) POSTs captured stats to. Baked into
# bookmarklet.js at build time - see vite.bookmarklet.config.ts and
# src/bookmarklet/entrypoint.ts. Distinct from VITE_GRAPHQL_URL because the
# bookmarklet talks to the /ingest REST endpoint directly, not GraphQL. Has
# no runtime fallback - `npm run build` fails loudly if this is unset.
VITE_API_ORIGIN=http://localhost:3000

# Copy to .env.local for local overrides (gitignored).
# URL of the Rails GraphQL endpoint.
VITE_GRAPHQL_URL=http://localhost:3000/graphql
# Origin (scheme + host [+ port], no path) of the Rails API that the
# bookmarklet (bookmarklet.js) POSTs captured stats to. Baked into
# bookmarklet.js at build time - see vite.bookmarklet.config.ts and
# src/bookmarklet/entrypoint.ts. Distinct from VITE_GRAPHQL_URL because the
# bookmarklet talks to the /ingest REST endpoint directly, not GraphQL.
VITE_API_ORIGIN=http://localhost:3000
